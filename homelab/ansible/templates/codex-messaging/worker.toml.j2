# Purpose: permit only typed coordinator tools through the pinned subscription-backed worker.
forced_login_method = "chatgpt"
cli_auth_credentials_store = "file"
web_search = "disabled"
default_permissions = "messaging"
approval_policy = "never"

[features]
apps = false
plugins = false
remote_plugin = false
hooks = false
multi_agent = false
goals = false
browser_use = false
browser_use_external = false
browser_use_full_cdp_access = false
computer_use = false
image_generation = false
shell_tool = false
shell_snapshot = false
skill_search = false
workspace_dependencies = false
code_mode_host = false

[permissions.messaging.filesystem]
":root" = "read"
"/home" = "deny"
"/root" = "deny"
"/proc" = "deny"
"/var/lib/codex-messaging" = "deny"
"/etc/codex-messaging" = "deny"
"/run/codex-messaging" = "deny"

[permissions.messaging.network]
enabled = false
