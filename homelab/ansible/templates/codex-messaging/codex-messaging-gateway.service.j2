# Purpose: run the enrolled private-chat coordinator with no infrastructure credentials.
[Unit]
Description=Codex Telegram keyless coordinator
Wants=network-online.target
After=network-online.target codex-messaging-broker.service
Requires=codex-messaging-broker.service
ConditionFileNotEmpty=/var/lib/codex-messaging/telegram/bot-token

[Service]
Type=simple
Slice=codex-messaging.slice
MemoryMax=768M
TasksMax=96
LimitNOFILE=256
OOMPolicy=kill
User=codex-telegram
Group=codex-telegram
SupplementaryGroups=codex-messaging-client
ExecStart=/usr/bin/python3 -I /opt/codex-messaging/entry.py gateway
WorkingDirectory=/var/lib/codex-messaging/reference
Environment=HOME=/var/lib/codex-messaging/telegram LANG=C.UTF-8 PATH=/usr/bin:/bin
UMask=0077
Restart=on-failure
RestartSec=30
TimeoutStopSec=15
KillMode=control-group
# Fixed sudo changes only to codex-worker; no root command is authorized.
NoNewPrivileges=false
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-messaging/telegram /var/lib/codex-messaging/worker
InaccessiblePaths=/var/lib/codex-messaging/operations /etc/codex-messaging/broker.json
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictRealtime=true
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
