{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/homelab/ha-mcp-gateway-runtime-approval.schema.json",
  "title": "Attended HA MCP gateway production approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approver",
    "confirmed",
    "mode",
    "control_enabled",
    "ctid",
    "address",
    "artifact_sha256",
    "semantic_manifest_sha256",
    "tls_certificate_sha256",
    "server_ca_sha256",
    "client_ca_sha256",
    "test_client_certificate_sha256",
    "ha_ca_sha256",
    "deployment_authority_sha256",
    "approved_epoch",
    "expires_epoch"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "approver": {"const": "simon"},
    "confirmed": {"const": true},
    "mode": {"const": "production"},
    "control_enabled": {"type": "boolean"},
    "ctid": {"type": "integer", "minimum": 1},
    "address": {"type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tls_certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "server_ca_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "client_ca_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_client_certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ha_ca_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deployment_authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_epoch": {"type": "integer", "minimum": 1},
    "expires_epoch": {"type": "integer", "minimum": 1}
  }
}
